{
  "name": "planetar",
  "private": true,
  "version": "0.15.5",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:dmg": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg && npm run sign:mac-notifications && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --prepackaged release/mac-arm64/Planetar.app",
    "build:win": "vite build && electron-builder --win portable --x64",
    "sign:mac-notifications": "bash scripts/sign-mac-for-notifications.sh",
    "twemoji:fetch": "bash scripts/fetch-twemoji.sh",
    "prebuild:dmg": "test -d public/twemoji/72x72 || npm run twemoji:fetch",
    "prebuild:win": "test -d public/twemoji/72x72 || npm run twemoji:fetch",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "idb": "^8.0.3",
    "immer": "^11.1.15",
    "lucide-react": "^1.27.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.1.0-rc.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "app.planetar.desktop",
    "productName": "Planetar",
    "copyright": "Copyright © Planetar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Planetar may use the camera for Matrix calls and media.",
        "NSMicrophoneUsageDescription": "Planetar may use the microphone for voice messages and calls."
      }
    },
    "dmg": {
      "title": "Planetar",
      "artifactName": "Planetar-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Planetar-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Planetar-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
